# PHPStan: static analysis of the plugin's own code against WordPress, Polylang and Gravity Forms stubs.
# The stubs and the WordPress extension are dev dependencies in tests/unit/composer.json.
# See README.md → Code quality and security checks.
includes:
    - tests/unit/vendor/szepeviktor/phpstan-wordpress/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - supertext-polylang.php
        - includes
    scanFiles:
        - tests/unit/vendor/wpsyntex/polylang-stubs/polylang-stubs.php
        - tests/unit/vendor/php-stubs/gravity-forms-stubs/gravity-forms-stubs.php
    tmpDir: .phpstan-cache
