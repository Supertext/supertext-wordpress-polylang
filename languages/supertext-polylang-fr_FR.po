msgstr "Traduisez vos formulaires Gravity Forms dans toutes les langues."

msgid "Forms are authored in your default language (%s). Translate each form into the other languages manually or with Supertext; the translation is shown automatically on the front end for that language."
msgstr "Les formulaires sont créés dans votre langue par défaut (%s). Traduisez chaque formulaire dans les autres langues manuellement ou avec Supertext ; la traduction s'affiche automatiquement côté public pour cette langue."

msgid "Translate each form into your other languages manually or with Supertext."
msgstr "Traduisez chaque formulaire dans vos autres langues manuellement ou avec Supertext."

msgid "Translations are stored in %1$s and can be reviewed, edited or ordered from Supertext under %2$s."
msgstr "Les traductions sont stockées dans %1$s et peuvent être vérifiées, modifiées ou commandées auprès de Supertext sous %2$s."

msgid "Polylang"
msgstr "Polylang"

msgid "Supertext → String Translations"
msgstr "Supertext → Traductions des chaînes"

