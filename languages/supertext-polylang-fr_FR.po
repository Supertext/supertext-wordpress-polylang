# French translation of Supertext for Polylang.
# Source: the plugin's PHP files (text domain supertext-polylang). After editing, run: php scripts/compile-translations.php
msgid ""
msgstr ""
"Project-Id-Version: Supertext for Polylang\n"
"Language: fr_FR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=n > 1;\n"
