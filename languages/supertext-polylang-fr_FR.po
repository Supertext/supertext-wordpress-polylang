msgstr "Aucun contenu traduisible trouvé dans cet article. (source=%1$s, cible=%2$s, builder=%3$s, contenu=%4$d octets, titre=%5$d caractères)"

msgid "An order already exists for \"%1$s\" (%2$s)."
msgstr "Une commande existe déjà pour « %1$s » (%2$s)."

msgid "Supertext human-translation credentials are not configured."
msgstr "Les identifiants Supertext pour la traduction humaine ne sont pas configurés."

msgid "Select a translation type, a target language, and at least one post."
msgstr "Sélectionnez un type de traduction, une langue cible et au moins un article."

