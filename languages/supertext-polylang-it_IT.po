msgstr "Nessun contenuto traducibile trovato in questo articolo. (origine=%1$s, destinazione=%2$s, builder=%3$s, contenuto=%4$d byte, titolo=%5$d caratteri)"

msgid "An order already exists for \"%1$s\" (%2$s)."
msgstr "Esiste già un ordine per « %1$s » (%2$s)."

